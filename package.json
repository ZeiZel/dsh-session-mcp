{
  "name": "@nones/dsh-session-mcp",
  "version": "1.2.1",
  "description": "MCP server for DeepSeek Harness sessions — list, read and prompt live conversations from any MCP client",
  "type": "module",
  "license": "MIT",
  "author": "ZeiZel <valera2003lvov@yandex.ru>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeiZel/dsh-session-mcp.git"
  },
  "homepage": "https://github.com/ZeiZel/dsh-session-mcp#readme",
  "bugs": {
    "url": "https://github.com/ZeiZel/dsh-session-mcp/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "sessions",
    "claude",
    "codex",
    "cursor",
    "plugin",
    "bundle"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
